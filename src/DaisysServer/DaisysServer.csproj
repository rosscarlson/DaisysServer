<Project Sdk="Microsoft.NET.Sdk">

  <!-- The server: window, tray, listener, users, tokens, updates. Modules are loaded at runtime from modules\. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>DaisysServer</AssemblyName>
    <RootNamespace>DaisysServer</RootNamespace>
    <AssemblyTitle>Daisy's Server</AssemblyTitle>
    <ApplicationIcon>Assets\DaisysServer.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DaisysServer.Core\DaisysServer.Core.csproj" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\DaisysServer.ico" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
